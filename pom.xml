<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.matthy.oie</groupId>
  <artifactId>datatype-gdt</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <name>OIE GDT Data Type</name>
  <description>
    GDT (Geraete-Daten-Traeger) data type for Eclipse Open Integration Engine: the QMS interface between medical devices and practice systems.
  </description>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Must match the engine you deploy to (see the README). -->
    <oie.version>4.6.0</oie.version>
    <!--
      Code signing of the shared, server and client jars (launchers that check signatures refuse
      unsigned extension jars). Off unless a keystore is given: -Dsign.keystore=... -Dsign.storepass=...
      (or in ~/.m2/settings.xml). The signing profile below switches it on.
    -->
    <sign.skip>true</sign.skip>
    <sign.alias>x-connections</sign.alias>
    <sign.storetype>PKCS12</sign.storetype>
    <sign.tsa>http://timestamp.digicert.com</sign.tsa>
  </properties>

  <dependencies>
    <!-- Engine jars, installed into the local repository from <OIE_HOME> (see README). -->
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>server-api</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>donkey-server</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>donkey-model</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>client</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>client-core</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Already on the engine's classpath. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>2.20.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.14.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mozilla</groupId>
      <artifactId>rhino</artifactId>
      <version>1.7.13</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>

      <!-- The engine wants three separate jars: shared (serializer + properties), server, client. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>shared-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>shared</classifier>
              <includes><include>com/mirth/connect/plugins/datatypes/gdt/*.class</include></includes>
            </configuration>
          </execution>
          <execution>
            <id>server-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>server</classifier>
              <includes><include>com/mirth/connect/plugins/datatypes/gdt/server/**</include></includes>
            </configuration>
          </execution>
          <execution>
            <id>client-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>client</classifier>
              <includes><include>com/mirth/connect/plugins/datatypes/gdt/client/**</include></includes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Signs the three jars the engine loads, before the zip is made (same phase, declared first).
        The timestamp keeps the signature valid after the certificate expires.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jarsigner-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>sign-extension-jars</id>
            <phase>package</phase>
            <goals><goal>sign</goal></goals>
            <configuration>
              <skip>${sign.skip}</skip>
              <processMainArtifact>false</processMainArtifact>
              <processAttachedArtifacts>false</processAttachedArtifacts>
              <archiveDirectory>${project.build.directory}</archiveDirectory>
              <includes>
                <include>${project.build.finalName}-shared.jar</include>
                <include>${project.build.finalName}-server.jar</include>
                <include>${project.build.finalName}-client.jar</include>
              </includes>
              <keystore>${sign.keystore}</keystore>
              <storetype>${sign.storetype}</storetype>
              <storepass>${sign.storepass}</storepass>
              <alias>${sign.alias}</alias>
              <tsa>${sign.tsa}</tsa>
            </configuration>
          </execution>
          <execution>
            <id>verify-extension-jars</id>
            <phase>package</phase>
            <goals><goal>verify</goal></goals>
            <configuration>
              <skip>${sign.skip}</skip>
              <processMainArtifact>false</processMainArtifact>
              <processAttachedArtifacts>false</processAttachedArtifacts>
              <archiveDirectory>${project.build.directory}</archiveDirectory>
              <includes>
                <include>${project.build.finalName}-shared.jar</include>
                <include>${project.build.finalName}-server.jar</include>
                <include>${project.build.finalName}-client.jar</include>
              </includes>
              <errorWhenNotSigned>true</errorWhenNotSigned>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.8.0</version>
        <configuration>
          <descriptors>
            <descriptor>assembly.xml</descriptor>
          </descriptors>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- On as soon as a keystore is given (command line, settings.xml or the release workflow). -->
    <profile>
      <id>sign</id>
      <activation>
        <property><name>sign.keystore</name></property>
      </activation>
      <properties>
        <sign.skip>false</sign.skip>
      </properties>
    </profile>
  </profiles>
</project>
